// Dán toàn bộ vào dbdiagram.io. Thiết kế đề xuất; bảng hiện có chỉ lấy cột liên quan.
// customers khác users. countries theo shop; geo_countries là địa lý chung.

Table users {
  Note: 'Hiện có. Xác thực người thao tác và quyền xem đơn.'
  id bigint [pk, increment, not null, note: 'PK']
  email varchar(254) [not null, note: 'Email đăng nhập']
  status varchar(20) [not null, note: 'Trạng thái tài khoản']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table shops {
  Note: 'Hiện có. Shop bán hàng và xử lý từng đơn.'
  id bigint [pk, increment, not null, note: 'PK']
  owner_user_id bigint [not null, note: 'FK users.id']
  name varchar(100) [not null, note: 'Tên shop']
  status varchar(20) [not null, note: 'Trạng thái bán']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table products {
  Note: 'Hiện có. Kiểm tra sản phẩm thuộc shop và còn bán.'
  id bigint [pk, increment, not null, note: 'PK']
  shop_id bigint [not null, note: 'FK shops.id']
  owner_id bigint [not null, note: 'FK users.id']
  title varchar(180) [not null, note: 'Tên sản phẩm']
  status varchar(30) [not null, note: 'Trạng thái bán']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table product_variants {
  Note: 'Hiện có. Nguồn giá và tồn kho realtime.'
  id bigint [pk, increment, not null, note: 'PK']
  product_id bigint [not null, note: 'FK products.id']
  sku varchar(64) [not null, unique, note: 'UNIQUE']
  variant_key varchar(255) [not null, note: 'Khóa biến thể']
  price decimal(12,2) [not null, note: 'Giá hiện tại']
  stock_quantity int [not null, note: 'Tồn kho']
  status varchar(20) [not null, note: 'Trạng thái biến thể']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table CheckOutToken {
  Note: 'Hiện có. Dữ liệu checkout khách đã chốt.'
  id bigint [pk, increment, not null, note: 'PK']
  user_id bigint [not null, note: 'FK users.id']
  checkout_token uuid [not null, unique, note: 'UNIQUE']
  order_request_id varchar(36) [null, note: 'UNIQUE(user_id, order_request_id); chống tạo đơn trùng']
  items json [not null, note: 'product_id, variant_id, quantity']
  version int [not null, note: 'Kiểm soát chỉnh sửa']
  is_completed boolean [not null, note: 'Đã tạo đơn hay chưa']
  shipping_address text [not null, note: 'Địa chỉ nháp']
  shipping_method text [not null, note: 'Rate đã chọn mỗi shop']
  payment_method json [not null, note: 'COD đã chọn']
  total text [not null, note: 'Báo giá nháp để so sánh']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table payment_methods {
  Note: 'Hiện có. Cấu hình COD của chủ shop.'
  id bigint [pk, increment, not null, note: 'PK']
  user_id bigint [not null, note: 'FK users.id']
  name varchar(100) [not null, note: 'Tên phương thức']
  payment_data json [not null, note: 'type, description, instructions']
  is_active boolean [not null, note: 'Đang hoạt động']
  is_deleted boolean [not null, note: 'Đã xóa mềm']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table shipping_methods {
  Note: 'Hiện có. Phương thức giao hàng của shop.'
  id bigint [pk, increment, not null, note: 'PK']
  shop_id bigint [not null, note: 'FK shops.id']
  name varchar(100) [not null, note: 'Tên phương thức']
  code varchar(50) [not null, note: 'Mã phương thức']
  status varchar(20) [not null, note: 'Phải active']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table shipping_rates {
  Note: 'Hiện có. Phí và số ngày giao của phương thức.'
  id bigint [pk, increment, not null, note: 'PK']
  shipping_method_id bigint [not null, note: 'FK shipping_methods.id']
  fixed_fee decimal(12,2) [not null, note: 'Phí mỗi order shop']
  min_delivery_days int [not null, note: 'Số ngày tối thiểu']
  max_delivery_days int [not null, note: 'Số ngày tối đa']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table countries {
  Note: 'Hiện có. Quốc gia shop hỗ trợ vận chuyển.'
  id bigint [pk, increment, not null, note: 'PK']
  shop_id bigint [not null, note: 'FK shops.id']
  name varchar(100) [not null, note: 'Tên quốc gia']
  country_code varchar(2) [not null, note: 'Mã ISO; model hiện tại varchar(2)']
  phone_code varchar(8) [not null, note: 'Mã điện thoại']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table shipping_rate_countries {
  Note: 'Hiện có. Nối rate với quốc gia giao được.'
  shipping_rate_id bigint [pk, not null, note: 'PK ghép và FK shipping_rates.id']
  country_id bigint [pk, not null, note: 'PK ghép và FK countries.id']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table geo_countries {
  Note: 'Tạo mới. Danh mục quốc gia chung cho địa chỉ.'
  id bigint [pk, increment, not null, note: 'PK']
  code varchar(2) [not null, unique, note: 'UNIQUE']
  name varchar(100) [not null, note: 'Tên quốc gia']
  phone_code varchar(8) [null, note: 'Mã điện thoại; dữ liệu địa lý có thể không có']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table provinces {
  Note: 'Tạo mới. Danh mục tỉnh thuộc quốc gia chung.'
  id bigint [pk, increment, not null, note: 'PK']
  country_id bigint [not null, note: 'FK geo_countries.id']
  code varchar(20) [not null, note: 'UNIQUE(country_id, code)']
  name varchar(100) [not null, note: 'Tên tỉnh hoặc bang']
  created_at datetime [not null]
  updated_at datetime [not null]
  indexes {
    (country_id, code) [unique]
  }
}

Table customers {
  Note: 'Tạo mới. Khách hàng riêng với User; tìm theo email.'
  id bigint [pk, increment, not null, note: 'PK']
  email varchar(254) [not null, note: 'Email checkout']
  email_key varchar(254) [not null, unique, note: 'UNIQUE; trim và lowercase']
  first_name varchar(100) [not null, note: 'Tên khách']
  last_name varchar(100) [not null, note: 'Họ khách']
  phone varchar(30) [not null, note: 'Điện thoại']
  country_id bigint [not null, note: 'FK geo_countries.id']
  province_id bigint [null, note: 'FK provinces.id; nullable']
  city varchar(100) [not null, note: 'Thành phố']
  ward varchar(100) [null, note: 'Phường hoặc xã; nullable']
  street varchar(200) [not null, note: 'Đường hoặc địa chỉ chi tiết']
  house_number varchar(50) [null, note: 'Số nhà; nullable theo quốc gia']
  apartment varchar(100) [null, note: 'Căn hộ; nullable']
  postal_code varchar(20) [null, note: 'Mã bưu chính; có thể bỏ trống']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table orders {
  Note: 'Tạo mới. Một đơn của một shop.'
  id bigint [pk, increment, not null, note: 'PK']
  checkout_id bigint [not null, note: 'FK CheckOutToken.id; cùng lần checkout']
  user_id bigint [not null, note: 'FK users.id; tài khoản đặt hàng']
  customer_id bigint [not null, note: 'FK customers.id']
  shop_id bigint [not null, note: 'FK shops.id']
  order_code varchar(50) [not null, unique, note: 'UNIQUE']
  order_name varchar(100) [not null, note: 'Tên đơn hiển thị']
  status varchar(20) [not null, note: 'Khởi tạo pending']
  sub_total decimal(18,2) [not null, note: 'Tổng line_total']
  shipping_fee decimal(18,2) [not null, note: 'Phí giao hàng']
  order_total decimal(18,2) [not null, note: 'sub_total + shipping_fee']
  currency char(3) [not null, note: 'VND']
  shipping_method_id bigint [not null, note: 'FK shipping_methods.id']
  shipping_rate_id bigint [not null, note: 'FK shipping_rates.id']
  shipping_method_name varchar(100) [not null, note: 'Tên tại lúc đặt']
  shipping_method_code varchar(50) [not null, note: 'Mã tại lúc đặt']
  min_delivery_days int [not null, note: 'Lưu từ rate']
  max_delivery_days int [not null, note: 'Lưu từ rate']
  estimated_delivery_from date [not null, note: 'Ngày dự kiến sớm nhất']
  estimated_delivery_to date [not null, note: 'Ngày dự kiến muộn nhất']
  payment_method_id bigint [not null, note: 'FK payment_methods.id']
  payment_method_data json [not null, note: 'id, type, name, description, instructions lúc đặt']
  payment_status varchar(20) [not null, note: 'Khởi tạo unpaid']
  paid_at datetime [null, note: 'Chưa thanh toán thì trống']
  created_at datetime [not null]
  updated_at datetime [not null]
  indexes {
    (checkout_id, shop_id) [unique]
  }
}

Table order_items {
  Note: 'Tạo mới. Các dòng hàng và giá tại lúc đặt.'
  id bigint [pk, increment, not null, note: 'PK']
  order_id bigint [not null, note: 'FK orders.id']
  product_id bigint [not null, note: 'FK products.id']
  product_variant_id bigint [not null, note: 'FK product_variants.id']
  product_name varchar(180) [not null, note: 'Tên tại lúc đặt']
  sku varchar(64) [not null, note: 'SKU tại lúc đặt']
  variant_data json [not null, note: 'Size, màu tại lúc đặt']
  image_url text [null, note: 'Ảnh; nullable']
  quantity int [not null, note: 'Số lượng checkout']
  unit_price decimal(18,2) [not null, note: 'Giá realtime lúc đặt']
  line_total decimal(18,2) [not null, note: 'unit_price × quantity']
  created_at datetime [not null]
  updated_at datetime [not null]
  indexes {
    (order_id, product_variant_id) [unique]
  }
}

Table order_addresses {
  Note: 'Tạo mới. Địa chỉ giao của đơn được lưu tách cột.'
  id bigint [pk, increment, not null, note: 'PK']
  order_id bigint [not null, unique, note: 'FK orders.id; UNIQUE']
  recipient_first_name varchar(100) [not null, note: 'Tên người nhận']
  recipient_last_name varchar(100) [not null, note: 'Họ người nhận']
  email varchar(254) [not null, note: 'Email liên hệ lúc đặt']
  phone varchar(30) [not null, note: 'Điện thoại lúc đặt']
  country_id bigint [not null, note: 'FK geo_countries.id']
  country_code char(2) [not null, note: 'Mã lúc đặt']
  country_name varchar(100) [not null, note: 'Tên lúc đặt']
  province_id bigint [null, note: 'FK provinces.id; nullable']
  province_code varchar(20) [null, note: 'Mã lúc đặt; nullable']
  province_name varchar(100) [null, note: 'Tên lúc đặt; nullable']
  city varchar(100) [not null, note: 'Thành phố']
  ward varchar(100) [null, note: 'Phường hoặc xã; nullable']
  street varchar(200) [not null, note: 'Đường hoặc địa chỉ chi tiết']
  house_number varchar(50) [null, note: 'Số nhà; nullable theo quốc gia']
  apartment varchar(100) [null, note: 'Căn hộ; nullable']
  postal_code varchar(20) [null, note: 'Mã bưu chính; có thể bỏ trống']
  created_at datetime [not null]
  updated_at datetime [not null]
}

// Quan hệ khóa ngoại
Ref: shops.owner_user_id > users.id
Ref: products.shop_id > shops.id
Ref: products.owner_id > users.id
Ref: product_variants.product_id > products.id
Ref: CheckOutToken.user_id > users.id
Ref: payment_methods.user_id > users.id
Ref: shipping_methods.shop_id > shops.id
Ref: shipping_rates.shipping_method_id > shipping_methods.id
Ref: countries.shop_id > shops.id
Ref: shipping_rate_countries.shipping_rate_id > shipping_rates.id
Ref: shipping_rate_countries.country_id > countries.id
Ref: provinces.country_id > geo_countries.id
Ref: customers.country_id > geo_countries.id
Ref: customers.province_id > provinces.id
Ref: orders.checkout_id > CheckOutToken.id
Ref: orders.user_id > users.id
Ref: orders.customer_id > customers.id
Ref: orders.shop_id > shops.id
Ref: orders.shipping_method_id > shipping_methods.id
Ref: orders.shipping_rate_id > shipping_rates.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: order_items.product_variant_id > product_variants.id
Ref: order_addresses.order_id - orders.id
Ref: order_addresses.country_id > geo_countries.id
Ref: order_addresses.province_id > provinces.id
Ref: orders.payment_method_id > payment_methods.id
