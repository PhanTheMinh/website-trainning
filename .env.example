PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=website_ban_do_chay_bo
DB_TEST_NAME=website_ban_do_chay_bo_test
DB_USER=root
DB_PASSWORD=

SESSION_SECRET=replace_with_a_long_random_secret
# Use none only when frontend/API are on different HTTPS sites.
SESSION_COOKIE_SAME_SITE=lax
# Number of trusted reverse-proxy hops in production. Use 0/off for direct HTTPS.
TRUST_PROXY=1

# Server-only key for optional checkout street suggestions. Never use VITE_ here.
GEOAPIFY_API_KEY=
# Street lists by administrative area; use a self-hosted/contracted endpoint for production.
STREET_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
